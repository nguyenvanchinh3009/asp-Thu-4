@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Đăng nhập CMS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>
        /* Nâng cấp Background - Gradient mượt mà hơn */
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Card Đăng nhập - Tăng chiều sâu */
        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 420px;
            border: 1px solid rgba(255,255,255,0.3);
        }

        /* Nâng cấp ô Input - Bo góc mềm mại, focus có màu */
        .form-control {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px 16px;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
            }

        /* Nâng cấp Nút Đăng nhập - Hiệu ứng hover nổi */
        .btn-login {
            background: linear-gradient(to right, #667eea, #764ba2);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-weight: 600;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(102, 126, 234, 0.4);
            }
    </style>
</head>

<body>

    <div class="card login-card">

        <div class="card-header-custom">

            <div class="logo-circle">
                <i class="fas fa-user-shield"></i>
            </div>

            <h3 class="fw-bold mb-1">
                CMS ADMIN
            </h3>

            <p class="mb-0 opacity-75">
                Hệ thống quản trị nội dung
            </p>

        </div>

        <div class="card-body">

            <form asp-action="Login" method="post">

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Tên đăng nhập
                    </label>

                    <div class="input-group-custom">

                        <i class="fas fa-user"></i>

                        <input type="text"
                               name="username"
                               class="form-control"
                               placeholder="Nhập tên đăng nhập"
                               required />

                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Mật khẩu
                    </label>

                    <div class="input-group-custom">

                        <i class="fas fa-lock"></i>

                        <input type="password"
                               name="password"
                               class="form-control"
                               placeholder="Nhập mật khẩu"
                               required />

                    </div>

                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger rounded-3">
                        <i class="fas fa-circle-exclamation me-2"></i>
                        @ViewBag.Error
                    </div>
                }

                <button type="submit"
                        class="btn btn-primary btn-login w-100">

                    <i class="fas fa-right-to-bracket me-2"></i>
                    ĐĂNG NHẬP

                </button>

            </form>

            <div class="footer-text">
                © 2026 CMS Management System
            </div>

        </div>

    </div>

</body>
</html>