<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cổng thông tin cá nhân NVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #f4f7f6;
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: 1px;
            color: #fff !important;
        }

        .hover-white:hover {
            color: #ffffff !important;
            transition: 0.3s;
        }

        .footer {
            background: #1a1a1a;
            color: #aaa !important;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary border-bottom shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-rocket-takeoff-fill me-2"></i>NVC_PORTFOLIO
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link text-white hover-white px-3" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door-fill me-1"></i> Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link text-white hover-white px-3" asp-controller="Category" asp-action="Index"><i class="bi bi-folder-fill me-1"></i> Danh mục</a></li>
                        <li class="nav-item"><a class="nav-link text-white hover-white px-3" asp-controller="Post" asp-action="Index"><i class="bi bi-journal-text me-1"></i> Bài viết</a></li>
                    </ul>
                    <div class="d-flex align-items-center ms-lg-4">
                        <span class="text-white small">
                            <i class="bi bi-person-circle me-1"></i> Admin: <strong>Nguyễn Văn Chính</strong>
                        </span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 mt-4">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-4 shadow-sm">
        <div class="container text-center text-md-start">
            <div class="row align-items-center">
                <div class="col-md-6 mb-2 mb-md-0">
                    <h6 class="text-uppercase fw-bold text-white mb-2">Hệ thống CMS cá nhân</h6>
                    <p class="small mb-0">&copy; 2026 | Nguyễn Văn Chính | MSSV: 2123110543</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="badge bg-dark border p-2">
                        <i class="bi bi-code-slash text-primary me-1"></i> ASP.NET Core MVC | Lớp: CCQ2311F
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>