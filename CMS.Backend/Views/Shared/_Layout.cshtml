<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChinhStore</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #2563eb;
            --bg-body: #f8fafc;
            --text-main: #1e293b;
            --card-bg: #ffffff;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
        }

        /* Navbar đổi màu sang xanh đen chuyên nghiệp */
        .navbar {
            background: #0f172a !important;
            padding: 1rem 0;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }

        .navbar-brand, .nav-link {
            color: #ffffff !important;
            font-weight: 600;
        }

        /* Các khối card nổi bật */
        .main-container {
            background: var(--card-bg);
            border-radius: 16px;
            margin-top: 2rem;
            padding: 2rem;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
        }

        /* Nút bấm bo góc */
        .btn-primary {
            background: var(--primary-color) !important;
            border-radius: 8px;
            padding: 0.6rem 1.5rem;
        }

        /* Footer tối giản */
        footer {
            text-align: center;
            padding: 3rem;
            color: #64748b;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">CHINHSTORE</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Product">Sản phẩm</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Cart"><i class="bi bi-cart-fill"></i> Giỏ hàng</a></li>
                    <li class="nav-item"><a class="nav-link btn btn-primary text-white px-3" href="/Account/Login">Đăng nhập</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container main-container">
        @RenderBody()
    </div>

    <footer>
        <div class="container text-center">
            <p>&copy; 2026 ChinhStore - Mua sắm tiện lợi</p>
            <div class="social-links">
                <i class="bi bi-facebook mx-2"></i>
                <i class="bi bi-instagram mx-2"></i>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>