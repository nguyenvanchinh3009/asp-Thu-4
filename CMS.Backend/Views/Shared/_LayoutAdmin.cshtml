            <ul class="list-unstyled components">
                <li class="nav-item"><a href="/Home" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                <li class="nav-item"><a href="/Category" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" ? "active" : "")"><i class="bi bi-list"></i> Danh mục</a></li>
                <li class="nav-item"><a href="/Post" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Post" ? "active" : "")"><i class="bi bi-file-text"></i> Bài viết</a></li>
                <li class="nav-item"><a href="/Product" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")"><i class="bi bi-box-seam"></i> Sản phẩm</a></li>
                <li class="nav-item"><a href="/Order" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Order" ? "active" : "")"><i class="bi bi-cart"></i> Đơn hàng</a></li>
                <li class="nav-item"><a href="/User" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" ? "active" : "")"><i class="bi bi-people"></i> Thành viên</a></li>
            </ul>
        </nav>

        <div id="content">
