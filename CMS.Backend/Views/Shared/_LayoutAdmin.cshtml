<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NVC Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
        }

        .sidebar {
            min-height: 100vh;
            background: linear-gradient(180deg, #2d3436 0%, #000000 100%);
            color: #fff;
            box-shadow: 2px 0 10px rgba(0,0,0,0.1);
        }

            .sidebar .brand {
                padding: 25px;
                font-weight: 800;
                font-size: 1.2rem;
                color: #00cec9;
            }

            .sidebar a {
                color: #b2bec3;
                padding: 15px 25px;
                display: block;
                transition: 0.3s;
                text-decoration: none;
                border-left: 4px solid transparent;
            }

                .sidebar a:hover, .sidebar a.active {
                    background: rgba(255,255,255,0.05);
                    color: #fff;
                    border-left: 4px solid #00cec9;
                }

        .admin-header {
            background: white;
            border-bottom: 2px solid #eee;
            padding: 15px 30px;
        }
    </style>
</head>
<body>
    <div class="container-fluid g-0">
        <div class="row g-0">
            <nav class="col-md-3 col-lg-2 sidebar">
                <div class="brand text-center"><i class="bi bi-terminal-fill me-2"></i>NVC PORTAL</div>
                <div class="px-4 py-2 text-uppercase text-muted small fw-bold">Menu quản lý</div>
                <a asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2"></i>Trang chủ</a>
                <a asp-controller="Category" asp-action="Index"><i class="bi bi-grid-3x3-gap me-2"></i>Danh mục</a>
                <a asp-controller="Post" asp-action="Index"><i class="bi bi-pencil-square me-2"></i>Bài viết</a>
                <a asp-controller="User" asp-action="Index"><i class="bi bi-people me-2"></i>Thành viên</a>
            </nav>

            <main class="col-md-9 col-lg-10">
                <header class="admin-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 fw-bold">@ViewData["Title"]</h4>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted"><i class="bi bi-person-badge me-1"></i> Admin: <b>Nguyễn Văn Chính</b></span>
                        <a href="#" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right"></i></a>
                    </div>
                </header>

                <div class="p-4">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>